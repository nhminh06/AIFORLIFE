NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# OpenRouter AI — dùng cho tính năng "Tạo bộ từ vựng bằng AI"
# Lấy key tại https://openrouter.ai/keys
OpenRouter.api.key=your_openrouter_api_key_here
# (tuỳ chọn) key thứ 2, 3… — dùng để chạy song song, tạo bài tập nhanh hơn
# OpenRouter.api.key1=your_second_openrouter_api_key_here
# (tuỳ chọn) đổi model khác của OpenRouter
OpenRouter_MODEL=openrouter/free
# (tuỳ chọn) bật "suy luận ẩn" cho phần tạo bài tập — chậm hơn nhưng câu hỏi khó hơn
# GRAMMAR_PRACTICE_REASONING=true
# (tuỳ chọn) các model dự phòng khi model chính bận — cách nhau bằng dấu phẩy
# OpenRouter_FALLBACK_MODELS=deepseek/deepseek-v4-flash-0731:free,z-ai/glm-5.2:free
